SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
PASSWORD_RESET_RATE_LIMIT_ATTEMPTS=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900
ADMIN_ACTION_RATE_LIMIT_ATTEMPTS=10
ADMIN_ACTION_RATE_LIMIT_WINDOW_SECONDS=300
ADMIN_TWO_FACTOR_REQUIRED=false
PASSWORD_HASH_SCHEME=argon2id
PLATFORM_OWNER_EMAIL=t.shiva@yalumni.org
PLATFORM_OWNER_ALIASES=tshiva@yalumni.org
PLATFORM_OWNER_DISPLAY_NAME=Patient0
PLATFORM_OWNER_PASSWORD=
SEED_TEST_ACCOUNTS=false
