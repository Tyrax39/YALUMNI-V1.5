UPLOAD_STORAGE_PREFIX=yalumni
VERIFICATION_UPLOAD_DIR=.local/uploads/verification
VERIFICATION_UPLOAD_MAX_BYTES=5242880
VERIFICATION_UPLOAD_ALLOWED_TYPES=application/pdf,image/jpeg,image/png,image/webp
PROFILE_PHOTO_UPLOAD_DIR=.local/uploads/profile-photos
PROFILE_PHOTO_UPLOAD_MAX_BYTES=2097152
PROFILE_PHOTO_UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
COMMUNITY_POST_MEDIA_UPLOAD_DIR=.local/uploads/community-post-media
COMMUNITY_POST_MEDIA_UPLOAD_MAX_BYTES=8388608
COMMUNITY_POST_MEDIA_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf
NOTIFICATION_STREAM_POLL_SECONDS=8
NOTIFICATION_DIGEST_WORKER_INTERVAL_SECONDS=3600
NOTIFICATION_DIGEST_WORKER_FREQUENCIES=DAILY,WEEKLY
NOTIFICATION_DIGEST_WORKER_LIMIT=100
NOTIFICATION_DIGEST_WORKER_MAX_ITEMS_PER_EMAIL=10
NOTIFICATION_DIGEST_WORKER_INCLUDE_READ=false
