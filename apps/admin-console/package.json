{
  "name": "@yalumni/admin-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node -e \"const fs=require('fs');for(const p of ['.next/dev','tsconfig.tsbuildinfo'])fs.rmSync(p,{recursive:true,force:true})\"",
    "dev": "next dev --hostname 0.0.0.0 --port 3011",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3011",
    "lint": "eslint . --max-warnings=0",
    "smoke:routes": "node scripts/smoke-routes.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@yalumni/frontend-shared": "0.1.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.4",
    "postcss": "^8.5.13",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3"
  }
}
